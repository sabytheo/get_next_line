char	*get_next_line(int fd)
{
	char		buffer[BUFFER_SIZE + 1];
	ssize_t		bytes_read;
	static char	*saved_data = NULL;
	char		*posnewline;
	char		*line;
	char		*temp;
	char		*temp2;

	posnewline = NULL;
	if (fd < 0 || BUFFER_SIZE <= 0 || read(fd, buffer, 0) < 0)
		return (NULL);
	bytes_read = read(fd, buffer, BUFFER_SIZE);
	while (bytes_read > 0)
	{
		buffer[bytes_read] = '\0';
		temp = ft_strjoin(saved_data, buffer);
		if (!temp)
			return (NULL);
		free(saved_data);
		saved_data = temp;
		posnewline = ft_strchr(saved_data, '\n');
		if (posnewline)
		{
			line = ft_substr(saved_data, 0, posnewline - saved_data + 1);
			temp2 = ft_strdup(posnewline + 1);
			free(saved_data);
			saved_data = temp2;
			return (line);
		}
	}
	if (bytes_read < 0)
		return (NULL);
	if (saved_data)
	{
		posnewline = ft_strchr(saved_data, '\n');
		if (posnewline)
		{
			line = ft_substr(saved_data, 0, posnewline - saved_data + 1);
			temp2 = ft_strdup(posnewline + 1);
			free(saved_data);
			saved_data = temp2;
			return (line);
		}
		else if (*saved_data)
		{
			line = ft_strdup(saved_data);
			free(saved_data);
			saved_data = NULL;
			return (line);
		}
	}
	free(saved_data);
	saved_data = NULL;
	return (NULL);
}
